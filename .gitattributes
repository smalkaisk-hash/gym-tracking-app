# tests/qa/fuzz.test.mjs contains a literal NUL byte in its hostile-string corpus (the
# point is to feed the real thing to the parsers, not an escape of it). Git sniffs that
# and classifies the file as binary, so `git diff` reports "Bin 53620 -> 66243" and every
# line of a change to it is invisible in review — which is how ~200 lines of new legal-
# surface guards once went unread. This forces the textual diff.
tests/qa/fuzz.test.mjs diff

# Published pages are generated by `npm run legal`. Marking them as generated collapses
# them by default in review: the source of truth is legal/*.md, and reviewing the HTML
# instead of the markdown is reviewing the wrong artefact.
public/*.html linguist-generated=true
