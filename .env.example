# Copy to .env.local (gitignored) and fill in from your Supabase project:
#   Supabase dashboard → Project Settings → API
# Vite only exposes vars prefixed with VITE_ to the browser.
# Use the BASE project URL only — no /rest/v1/ suffix.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional — error tracking (Sentry). Leave blank to disable entirely: with no
# DSN the app loads no Sentry code and makes no network calls. To turn it on,
# create a project at sentry.io (free tier), copy its DSN here, and rebuild.
VITE_SENTRY_DSN=
